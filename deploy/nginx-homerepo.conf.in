# HomeRepo — создано установщиком (deploy/install.sh)
# Репозиторий для клиентов: http://<сервер>/homerepo/... (как и раньше)
# Панель: https://<сервер>/  (процесс homerepo-web на 127.0.0.1:@PORT@)

server {
    listen 80;
    listen [::]:80;
    server_name @NAMES@;

    location /homerepo/ {
        alias @REPO_ROOT@/;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        types { application/x-rpm rpm; text/xml xml; application/pgp-signature asc; }
        default_type application/octet-stream;
    }
    location = /homerepo/setup.sh {
        proxy_pass http://127.0.0.1:@PORT@/agent/setup.sh;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    # служебные временные файлы службы подписи не отдаём
    location ~ /\. { deny all; }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @NAMES@;

    ssl_certificate     @CRT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:homerepo:2m;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location /homerepo/ {
        alias @REPO_ROOT@/;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        types { application/x-rpm rpm; text/xml xml; application/pgp-signature asc; }
        default_type application/octet-stream;
    }
    location = /homerepo/setup.sh {
        proxy_pass http://127.0.0.1:@PORT@/agent/setup.sh;
        proxy_set_header Host $host;
    }
    location ~ /\. { deny all; }

    location / {
        proxy_pass http://127.0.0.1:@PORT@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
